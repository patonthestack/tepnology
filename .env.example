# Copy to .env.local and fill in. Never commit real keys.

# Resend API key (https://resend.com/api-keys). Required in production for the contact form.
RESEND_API_KEY=

# Inbox that receives contact-form inquiries. Defaults to site.email in src/lib/site.ts.
CONTACT_TO_EMAIL=

# Sender address on your verified Resend domain. Leave empty to use Resend's test sender
# (onboarding@resend.dev), which can only deliver to the email on your Resend account.
CONTACT_FROM_EMAIL="Tepnology Website <website@tepnology.com>"
